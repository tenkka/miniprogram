.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #0C0B09;
  border-top: 1rpx solid rgba(212, 175, 55, 0.22);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 10rpx;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
}

/* Unselected: keep the grey outline as-is */
.tab-icon--off {
  opacity: 0.55;
}

/* Selected: grey → sepia warm brown → saturate + nudge hue → gold */
.tab-icon--on {
  filter: sepia(1) saturate(4) hue-rotate(8deg) brightness(0.92);
  opacity: 1;
}

.tab-label {
  font-size: 20rpx;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.38);
}

.tab-label--on {
  color: #D4AF37;
  font-weight: 600;
}
