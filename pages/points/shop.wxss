page { background: #0C0B09; }

.page {
  min-height: 100vh;
  background: #0C0B09;
  padding-bottom: 60rpx;
}

/* ===== 余额条 ===== */
.balance-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  background: linear-gradient(90deg, #1C1A12, #161309);
  border-bottom: 1rpx solid rgba(212,175,55,0.15);
}

.balance-bar-label {
  font-size: 26rpx;
  color: rgba(212,175,55,0.7);
  letter-spacing: 1rpx;
}

.balance-bar-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #E8C94A;
  font-variant-numeric: tabular-nums;
}

/* ===== 空 / 加载 ===== */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
  gap: 16rpx;
}

.state-icon { font-size: 80rpx; line-height: 1; }
.state-title { font-size: 30rpx; font-weight: 600; color: #555; }
.state-sub { font-size: 24rpx; color: #383428; }
.state-text { font-size: 28rpx; color: #444; }

/* ===== 商品列表 ===== */
.items-grid {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  display: flex;
  gap: 0;
  background: linear-gradient(145deg, #1C1A12 0%, #131108 100%);
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.6);
  position: relative;
}

.item-card--sold-out {
  opacity: 0.5;
}

.item-img {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.item-img-placeholder {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A1710;
}

.item-placeholder-icon { font-size: 72rpx; }

.item-body {
  flex: 1;
  padding: 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #F0E8CC;
  line-height: 1.3;
}

.item-desc {
  font-size: 24rpx;
  color: #5A5040;
  line-height: 1.5;
  margin-top: 8rpx;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.item-cost {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.item-cost-icon { font-size: 28rpx; }

.item-cost-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #D4AF37;
  font-variant-numeric: tabular-nums;
}

.item-unit {
  font-size: 22rpx;
  color: #6A5C38;
  margin-left: 4rpx;
}

.item-stock {
  font-size: 22rpx;
  color: #3D3525;
}

.item-stock--low {
  color: #8B6914;
}

.sold-out-mask {
  position: absolute;
  inset: 0;
  background: rgba(12,11,9,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sold-out-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #4A4030;
  letter-spacing: 4rpx;
}

/* ===== 确认弹窗 ===== */
.confirm-drag {
  width: 80rpx;
  height: 8rpx;
  background: #333;
  border-radius: 4rpx;
  margin: 0 auto 36rpx;
}

.confirm-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8C94A;
  text-align: center;
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
}

.confirm-item-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 24rpx;
  background: #0F0E0B;
  border: 1rpx solid rgba(212,175,55,0.15);
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}

.confirm-item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  object-fit: cover;
  flex-shrink: 0;
}

.confirm-item-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A1710;
  font-size: 56rpx;
}

.confirm-item-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.confirm-item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #F0E8CC;
}

.confirm-cost-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.confirm-cost-icon { font-size: 28rpx; }

.confirm-cost-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #D4AF37;
}

.confirm-balance-tip {
  font-size: 24rpx;
  color: #4A4030;
  text-align: center;
  margin-bottom: 40rpx;
}

.confirm-balance-after {
  color: #C8A84A;
  font-weight: 600;
}

.confirm-btns {
  display: flex;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.confirm-btn--cancel {
  background: #1C1A12;
  border: 1rpx solid rgba(212,175,55,0.2);
  color: #7A6E58;
}

.confirm-btn--ok {
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  color: #0C0B09;
  box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.4);
}

.confirm-btn--loading {
  opacity: 0.6;
}
