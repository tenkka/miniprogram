page { background: #1A1A1A; }

.admin-page {
  min-height: 100vh;
  background: #1A1A1A;
  padding-bottom: 60rpx;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 20rpx;
}
.loading-text { font-size: 26rpx; color: #666; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.empty-text { font-size: 28rpx; color: #555; }

/* ===== Tab 内容 ===== */
.tab-content {
  padding: 28rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 桌台卡片 ===== */
.table-card {
  background: #252525;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.table-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.table-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
  background: rgba(212,175,55,0.15);
  color: #D4AF37;
  border: 1rpx solid rgba(212,175,55,0.35);
}

.table-name-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.table-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.table-meta {
  font-size: 24rpx;
  color: #666;
}

.edit-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(212,175,55,0.1);
  border: 1rpx solid rgba(212,175,55,0.3);
  border-radius: 24rpx;
}

.edit-text {
  font-size: 24rpx;
  color: #D4AF37;
}

/* ===== 发布栏 ===== */
.publish-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx;
}
.publish-bar-count {
  font-size: 24rpx;
  color: #666;
}
.publish-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 32rpx;
}
.publish-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* ===== 发布弹窗 ===== */
.publish-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #1E1E1E;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.7;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}
.publish-char-count {
  font-size: 22rpx;
  color: #555;
  text-align: right;
  margin-bottom: 24rpx;
}
.publish-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.publish-img-wrap {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}
.publish-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: block;
}
.publish-img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 1;
}
.publish-img-add {
  width: 192rpx;
  height: 192rpx;
  border: 2rpx dashed #3A3A3A;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.publish-img-add-text {
  font-size: 22rpx;
  color: #555;
}

/* ===== 清空栏 ===== */
.clear-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx;
}

.clear-bar-count {
  font-size: 24rpx;
  color: #666;
}

.clear-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background: rgba(230,67,64,0.08);
  border: 1rpx solid rgba(230,67,64,0.3);
  border-radius: 28rpx;
}

.clear-all-text {
  font-size: 24rpx;
  color: #E64340;
  font-weight: 600;
}

/* ===== 预约卡片 ===== */
.booking-card {
  display: flex;
  align-items: center;
  background: #252525;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  gap: 20rpx;
}

.booking-left { flex-shrink: 0; }

.booking-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.booking-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #2A2A2A;
  display: flex;
  align-items: center;
  justify-content: center;
}

.booking-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.booking-nick {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-meta {
  font-size: 22rpx;
  color: #666;
}

.booking-tags { display: flex; gap: 10rpx; }

.type-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.tag-booking {
  background: rgba(212,175,55,0.15);
  color: #D4AF37;
  border: 1rpx solid rgba(212,175,55,0.3);
}

.tag-queue {
  background: rgba(255,152,0,0.15);
  color: #FF9800;
  border: 1rpx solid rgba(255,152,0,0.3);
}

.booking-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.status-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-pending {
  background: rgba(212,175,55,0.12);
  color: #D4AF37;
  border: 1rpx solid rgba(212,175,55,0.3);
}

.status-confirmed {
  background: rgba(76,175,80,0.12);
  color: #4CAF50;
  border: 1rpx solid rgba(76,175,80,0.3);
}

.status-seated {
  background: rgba(41,182,246,0.12);
  color: #29B6F6;
  border: 1rpx solid rgba(41,182,246,0.3);
}

.status-cancelled {
  background: rgba(230,67,64,0.12);
  color: #E64340;
  border: 1rpx solid rgba(230,67,64,0.3);
}

/* ===== 广场卡片 ===== */
.post-card {
  background: #252525;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pin-badge {
  font-size: 22rpx;
  color: #D4AF37;
  background: rgba(212,175,55,0.1);
  border: 1rpx solid rgba(212,175,55,0.3);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.post-date { font-size: 22rpx; color: #555; }

.post-content {
  font-size: 26rpx;
  color: #CCC;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.post-actions {
  display: flex;
  gap: 16rpx;
}

.post-action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-pin {
  background: rgba(212,175,55,0.1);
  color: #D4AF37;
  border: 1rpx solid rgba(212,175,55,0.3);
}

.btn-unpin {
  background: rgba(255,255,255,0.05);
  color: #888;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.btn-delete {
  background: rgba(230,67,64,0.1);
  color: #E64340;
  border: 1rpx solid rgba(230,67,64,0.3);
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  background: #252525;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  gap: 20rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(212,175,55,0.3);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.user-nick {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-stats {
  display: flex;
  gap: 24rpx;
}

.user-stat {
  font-size: 24rpx;
  font-weight: 500;
}

.power-stat { color: #D4AF37; }
.champ-stat { color: #4CAF50; }

/* ===== 用户编辑弹窗 ===== */
.edit-user-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 36rpx;
  padding: 0 8rpx;
}

.edit-user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(212,175,55,0.4);
}

.edit-user-nick {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-field {
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
  display: block;
}

/* ===== 编辑弹窗 ===== */
.drag-bar {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  margin: 0 auto 40rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 8rpx;
}

.popup-sub {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  margin-bottom: 32rpx;
}

.num-input {
  width: 100%;
  height: 88rpx;
  background: #1A1A1A;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  border: 2rpx solid rgba(212,175,55,0.2);
  margin-bottom: 32rpx;
  box-sizing: border-box;
  text-align: center;
  letter-spacing: 4rpx;
}

/* ===== 用户编辑弹窗扩展 ===== */
.balance-stat { color: #D4AF37; }

.edit-user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.edit-balance-display {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.edit-balance-item {
  font-size: 22rpx;
  font-weight: 500;
}

.edit-balance-sep {
  font-size: 22rpx;
  color: #444;
}

.recharge-color { color: #D4AF37; }
.gift-color { color: #4CAF50; }

.section-label {
  font-size: 22rpx;
  color: #666;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.popup-divider {
  height: 1rpx;
  background: rgba(255,255,255,0.08);
  margin: 32rpx 0;
}

.points-balance-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(212,175,55,0.08);
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.points-balance-label {
  font-size: 26rpx;
  color: #888;
}

.points-balance-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #D4AF37;
  font-variant-numeric: tabular-nums;
}

.balance-row {
  display: flex;
  gap: 20rpx;
}

.balance-half {
  flex: 1;
}

.balance-input {
  text-align: left;
  letter-spacing: 0;
  border-color: rgba(76,175,80,0.25);
}

/* 查看明细按钮 */
.edit-balance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.view-detail-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 16rpx;
  background: rgba(212,175,55,0.08);
  border: 1rpx solid rgba(212,175,55,0.3);
  border-radius: 20rpx;
  flex-shrink: 0;
}

.view-detail-text {
  font-size: 20rpx;
  color: #D4AF37;
}

/* ===== 余额明细弹窗 ===== */
.detail-wrap {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
}

.detail-header {
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 20rpx;
}

.detail-summary {
  display: flex;
  background: #252525;
  border-radius: 16rpx;
  padding: 20rpx 0;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.detail-summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.detail-summary-divider {
  width: 1rpx;
  background: rgba(255,255,255,0.1);
  margin: 4rpx 0;
}

.detail-summary-label {
  font-size: 20rpx;
  color: #666;
}

.detail-summary-val {
  font-size: 30rpx;
  font-weight: 600;
}

.detail-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-scroll {
  flex: 1;
  height: 0;
  padding-bottom: 60rpx;
}

.detail-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.detail-empty-text {
  font-size: 26rpx;
  color: #444;
}

.detail-log-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  gap: 20rpx;
}

.detail-log-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.detail-log-type-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.badge-add {
  background: rgba(76,175,80,0.12);
  color: #4CAF50;
  border: 1rpx solid rgba(76,175,80,0.3);
}

.badge-minus {
  background: rgba(230,67,64,0.12);
  color: #E64340;
  border: 1rpx solid rgba(230,67,64,0.3);
}

.detail-log-date {
  font-size: 22rpx;
  color: #555;
}

.detail-log-note {
  font-size: 22rpx;
  color: #888;
  background: rgba(255,255,255,0.04);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.detail-log-amount {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  text-align: right;
  line-height: 1.5;
}

.amount-add { color: #4CAF50; }
.amount-minus { color: #E64340; }

.deduct-input {
  border-color: rgba(230,67,64,0.3);
}

/* ===== 用户搜索栏 ===== */
.user-search-bar {
  display: flex;
  align-items: center;
  background: #252525;
  border-radius: 48rpx;
  padding: 0 28rpx;
  height: 80rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.user-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
  height: 100%;
}

/* ===== 用户卡片手机号 ===== */
.user-phone-row {
  display: flex;
  align-items: center;
}

.user-phone {
  font-size: 24rpx;
}

.phone-bound { color: #4CAF50; }
.phone-unbound { color: #444; }
