<view class="container">
  <!-- 顶部图片区域 -->
  <view class="header-section">
    <image class="shop-cover" mode="aspectFill" src="{{shopInfo.pic}}"></image>
    <view class="cover-overlay"></view>
  </view>

  <!-- 门店信息卡片 -->
  <view class="shop-card">
    <view class="shop-title-area">
      <view class="shop-name">{{shopInfo.name}}</view>
      <view class="shop-tag" wx:if="{{shopInfo.characteristic}}">
        <text class="tag-icon">✨</text>
        <text class="tag-text">{{shopInfo.characteristic}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷操作按钮 -->
  <view class="action-buttons">
    <view class="action-btn" bind:tap="phoneCall">
      <view class="btn-icon phone-icon">📞</view>
      <view class="btn-text">联系电话</view>
      <view class="btn-sub-text">{{shopInfo.linkPhone}}</view>
    </view>
    <view class="action-divider"></view>
    <view class="action-btn" bind:tap="guideNow">
      <view class="btn-icon nav-icon">🧭</view>
      <view class="btn-text">到店导航</view>
      <view class="btn-sub-text">查看地图</view>
    </view>
  </view>

  <!-- 详细信息区域 -->
  <view class="detail-section">
    <view class="detail-title">门店信息</view>
    
    <view class="info-item">
      <view class="info-label">
        <text class="label-icon">🕐</text>
        <text>营业时间</text>
      </view>
      <view class="info-value">{{shopInfo.openingHours}}</view>
    </view>

    <view class="info-item">
      <view class="info-label">
        <text class="label-icon">📍</text>
        <text>门店地址</text>
      </view>
      <view class="info-value">{{shopInfo.address}}</view>
    </view>
  </view>

  <!-- 地图区域 -->
  <view class="map-section">
    <view class="map-header">
      <text class="map-title">📌 门店位置</text>
      <text class="map-tip" bind:tap="guideNow">点击导航 →</text>
    </view>
    <map 
      id="map" 
      class="map-container" 
      latitude="{{shopInfo.latitude}}" 
      longitude="{{shopInfo.longitude}}" 
      markers="{{markers}}" 
      show-location 
      enable-3D
      show-compass 
      show-scale
      enable-rotate
      enable-traffic 
    />
  </view>

  <!-- 底部安全距离 -->
  <view class="safe-bottom"></view>
</view>