page { background: #1A1A1A; }

.page {
  padding: 24rpx 28rpx 60rpx;
}

.product-card {
  background: #252525;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255,255,255,0.06);
  margin-bottom: 28rpx;
}

.product-image {
  width: 100%;
  height: 360rpx;
  display: block;
}

.product-body {
  padding: 28rpx 32rpx 32rpx;
}

.product-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
}

.price-tag {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  flex-shrink: 0;
}

.price-symbol {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: 600;
}

.price-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #D4AF37;
}

.product-points-row {
  margin-bottom: 12rpx;
}

.product-points-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #D4AF37;
  background: rgba(212,175,55,0.1);
  border: 1rpx solid rgba(212,175,55,0.25);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-variant-numeric: tabular-nums;
}

.product-desc {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.buy-btn {
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 48rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buy-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

/* ===== 支付弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-box {
  width: 100%;
  background: #252525;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 40rpx 80rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-product-name {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(212,175,55,0.08);
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.modal-price-label {
  font-size: 28rpx;
  color: #CCCCCC;
}

.modal-price-val {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.modal-price-symbol {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: 600;
}

.modal-price-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #D4AF37;
}

.modal-balance-section {
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.modal-balance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.modal-balance-label {
  font-size: 26rpx;
  color: #666;
}

.modal-balance-val {
  font-size: 26rpx;
  color: #CCCCCC;
  font-weight: 600;
}

/* ===== 支付构成 ===== */
.modal-split-section {
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 20rpx;
}

.modal-split-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.modal-split-row:last-child { border-bottom: none; }

.after-balance { opacity: 0.6; }

.split-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.split-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.balance-dot { background: #4CAF50; }
.wechat-dot  { background: #07C160; }

.split-label {
  font-size: 27rpx;
  color: #CCCCCC;
}

.split-sub {
  font-size: 23rpx;
  color: #555;
}

.split-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.balance-amount { color: #4CAF50; }
.wechat-amount  { color: #FFFFFF; }
.after-label    { color: #555; font-size: 25rpx; }
.after-amount   { color: #555; font-size: 27rpx; font-weight: 600; }

.modal-method {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 36rpx;
}

.modal-method--balance {
  background: rgba(76,175,80,0.1);
  border: 1rpx solid rgba(76,175,80,0.3);
}

.modal-method--wechat {
  background: rgba(255,152,0,0.1);
  border: 1rpx solid rgba(255,152,0,0.3);
}

.modal-method--mixed {
  background: rgba(33,150,243,0.1);
  border: 1rpx solid rgba(33,150,243,0.3);
}

.modal-method--mixed .modal-method-text { color: #64B5F6; }

.modal-method-icon {
  font-size: 26rpx;
}

.modal-method--balance .modal-method-icon { color: #4CAF50; }
.modal-method--wechat .modal-method-icon { color: #FF9800; }

.modal-method-text {
  font-size: 26rpx;
  flex: 1;
}

.modal-method--balance .modal-method-text { color: #4CAF50; }
.modal-method--wechat .modal-method-text { color: #FF9800; }

.modal-bonus-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(212,175,55,0.08);
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 16rpx;
  padding: 18rpx 28rpx;
  margin-bottom: 28rpx;
}

.modal-bonus-label {
  font-size: 26rpx;
  color: rgba(212,175,55,0.7);
}

.modal-bonus-points {
  font-size: 30rpx;
  font-weight: 700;
  color: #D4AF37;
  font-variant-numeric: tabular-nums;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-cancel-btn {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #888;
  font-weight: 600;
}

.modal-confirm-btn {
  flex: 2;
  height: 88rpx;
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
}

.modal-confirm-btn--loading {
  opacity: 0.6;
}
