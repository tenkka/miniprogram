page { background: #1A1A1A; }

.detail-container {
  min-height: 100vh;
  background: #1A1A1A;
  padding-bottom: 80rpx;
}

.center-loading {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

/* ===== 顶部标题 ===== */
.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 24rpx;
}

.table-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.table-stat {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #D4AF37;
}

.stat-slash, .stat-total {
  font-size: 32rpx;
  color: #666;
}

.stat-unit {
  font-size: 26rpx;
  color: #666;
}

/* ===== 桌台可视化区域 ===== */
.table-stage {
  position: relative;
  width: 750rpx;
  height: 460rpx;
  margin: 0 auto;
}

.oval-table {
  position: absolute;
  width: 340rpx;
  height: 200rpx;
  background: linear-gradient(145deg, #2A1A0A, #1A0F0F);
  border: 4rpx solid rgba(212,175,55,0.3);
  border-radius: 100rpx;
  left: 205rpx;
  top: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 60rpx rgba(139,32,32,0.2), inset 0 0 40rpx rgba(0,0,0,0.4);
}

.oval-label {
  font-size: 22rpx;
  color: rgba(212,175,55,0.4);
  letter-spacing: 4rpx;
  font-weight: 700;
}

/* ===== 座位 ===== */
.seat {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 3rpx solid transparent;
  overflow: visible;
}

.seat-empty {
  background: #2A2A2A;
  border-color: #3A3A3A;
}

.seat-pending {
  background: #1A1500;
  border-color: rgba(212,175,55,0.5);
  box-shadow: 0 0 16rpx rgba(212,175,55,0.2);
}

.seat-confirmed {
  background: #1A0F00;
  border-color: #D4AF37;
  box-shadow: 0 0 24rpx rgba(212,175,55,0.4);
}

.seat-seated {
  background: #001A08;
  border-color: #4CAF50;
  box-shadow: 0 0 24rpx rgba(76,175,80,0.4);
}

.seat-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.seat-nick {
  position: absolute;
  bottom: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 18rpx;
  color: #AAA;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

/* ===== 图例 ===== */
.legend-row {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 16rpx 0 32rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #666;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.dot-empty { background: #2A2A2A; border-color: #3A3A3A; }
.dot-pending { background: #1A1500; border-color: rgba(212,175,55,0.5); }
.dot-confirmed { background: #D4AF37; }
.dot-seated { background: #4CAF50; }

/* ===== 排队列表 ===== */
.section {
  margin: 8rpx 32rpx 0;
  background: #252525;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #888;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.queue-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.queue-no {
  font-size: 32rpx;
  font-weight: 700;
  color: #D4AF37;
  width: 40rpx;
  text-align: center;
}

.queue-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.queue-nick {
  flex: 1;
  font-size: 28rpx;
  color: #DDD;
}

.queue-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.queue-status.pending {
  color: #888;
  background: rgba(255,255,255,0.06);
}

/* ===== 我的预约 ===== */
.my-section {
  margin: 0 32rpx 24rpx;
}

.my-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.my-card {
  background: #252525;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(212,175,55,0.2);
}

.my-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.my-type-label {
  font-size: 28rpx;
  font-weight: 600;
}

.my-type-label.booking { color: #D4AF37; }
.my-type-label.confirmed { color: #D4AF37; }
.my-type-label.seated { color: #4CAF50; }
.my-type-label.queue { color: #FF9800; }

.my-arrival {
  font-size: 24rpx;
  color: #888;
}

.cancel-btn {
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 24rpx;
}

/* ===== 操作按钮 ===== */
.action-bar {
  padding: 16rpx 32rpx 0;
}

/* ===== 管理员列表 ===== */
.admin-section { margin-top: 24rpx; }

.admin-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.tappable { active-background-color: rgba(255,255,255,0.05); }

.admin-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.admin-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.admin-nick {
  font-size: 28rpx;
  color: #DDD;
}

.admin-arrival {
  font-size: 22rpx;
  color: #666;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-tag.pending {
  color: #D4AF37;
  background: rgba(212,175,55,0.12);
  border: 1rpx solid rgba(212,175,55,0.3);
}

.status-tag.confirmed {
  color: #D4AF37;
  background: rgba(212,175,55,0.2);
  border: 1rpx solid #D4AF37;
}

.status-tag.seated {
  color: #4CAF50;
  background: rgba(76,175,80,0.15);
  border: 1rpx solid #4CAF50;
}

/* ===== 预约弹窗 ===== */
.join-form { padding: 24rpx 40rpx 60rpx; }

.form-drag-bar {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  margin: 0 auto 40rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 12rpx;
}

.form-subtitle {
  text-align: center;
  margin-bottom: 40rpx;
}

.subtitle-table {
  font-size: 26rpx;
  color: #888;
}

.form-item { margin-bottom: 28rpx; }

.form-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
  display: block;
}

.required { color: #8B2020; }
