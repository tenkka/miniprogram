<view class="hall-container">

  <!-- 顶部 -->
  <view class="hall-header">
    <view class="header-content">
      <view class="hall-title-area" bindtap="goStores">
        <text class="hall-suits">♠♥♣♦</text>
        <text class="hall-title">{{currentStore.name || '选择门店'}}</text>
        <text class="hall-store-switch">切换 ›</text>
      </view>
      <view class="hall-stats">
        <view class="stat-item">
          <text class="stat-val gold">{{openCount}}</text>
          <text class="stat-label">可预约</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-val">{{fullCount}}</text>
          <text class="stat-label">排队等候</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 筛选 Tabs -->
  <view class="filter-bar">
    <view
      wx:for="{{filterLabels}}"
      wx:key="index"
      class="filter-chip {{filterTab === index ? 'filter-chip--on' : ''}}"
      data-tab="{{index}}"
      bindtap="setFilter"
    >{{item}}</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="center-state">
    <van-loading color="#D4AF37" size="48rpx" />
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{filteredTables.length === 0}}" class="center-state">
    <text class="empty-icon">🃏</text>
    <text class="empty-text">暂无{{filterTab === 1 ? '可预约' : filterTab === 2 ? '满员' : ''}}桌台</text>
    <text class="empty-sub">请联系工作人员了解最新安排</text>
  </view>

  <!-- 桌台列表 -->
  <view wx:else class="table-list">
    <view
      wx:for="{{filteredTables}}"
      wx:key="_id"
      wx:for-item="table"
      class="table-row"
    >
      <!-- 桌台名称 -->
      <text class="row-name">{{table.name}}</text>

      <!-- 人数 -->
      <view class="row-count">
        <van-icon name="friends-o" size="30rpx" color="#D4AF37" />
        <text class="row-count-text">{{table.occupiedCount}}/{{table.maxplayer}}</text>
      </view>

      <!-- 预约按钮 -->
      <view
        class="row-btn {{table.myBooking ? 'row-btn--booked' : table.isFull ? 'row-btn--queue' : 'row-btn--open'}}"
        bindtap="onBookTap"
        data-table="{{table}}"
      >
        <text class="row-btn-text">{{table.myBooking ? '已预约' : table.isFull ? '排队' : '预约'}}</text>
      </view>
    </view>
  </view>

</view>
