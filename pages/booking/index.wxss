page { background: #0C0B09; }

.hall-container {
  min-height: 100vh;
  background: #0C0B09;
  padding-bottom: 60rpx;
}

/* ===== 顶部 ===== */
.hall-header {
  background: linear-gradient(150deg, #0C0B09 0%, #1C0808 50%, #6B1A1A 100%);
  padding: 48rpx 40rpx 44rpx;
  position: relative;
  overflow: hidden;
}

.hall-header::after {
  content: '♠♣';
  position: absolute;
  right: -10rpx;
  bottom: -30rpx;
  font-size: 260rpx;
  color: rgba(255,255,255,0.03);
  line-height: 1;
  pointer-events: none;
}

.header-content {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.hall-title-area { display: flex; flex-direction: column; gap: 8rpx; }
.hall-suits { font-size: 24rpx; color: #D4AF37; letter-spacing: 6rpx; }
.hall-title { font-size: 56rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 6rpx; }
.hall-store-switch { font-size: 22rpx; color: rgba(212,175,55,0.7); letter-spacing: 1rpx; }

.hall-stats { display: flex; align-items: center; gap: 28rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-val { font-size: 48rpx; font-weight: 800; color: rgba(255,255,255,0.6); font-variant-numeric: tabular-nums; }
.stat-val.gold { color: #D4AF37; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.4); }
.stat-divider { width: 2rpx; height: 60rpx; background: rgba(255,255,255,0.12); }

/* ===== 筛选 Tabs ===== */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 32rpx 20rpx;
  background: #0C0B09;
  border-bottom: 1rpx solid rgba(212,175,55,0.08);
}

.filter-chip {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #555;
  background: #181510;
  border: 1rpx solid transparent;
  letter-spacing: 1rpx;
}

.filter-chip--on {
  color: #D4AF37;
  background: rgba(212,175,55,0.1);
  border-color: rgba(212,175,55,0.4);
  font-weight: 700;
}

/* ===== 状态页 ===== */
.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 32rpx; color: #555; font-weight: 600; }
.empty-sub { font-size: 26rpx; color: #383428; }

/* ===== 桌台列表 ===== */
.table-list {
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.table-row {
  display: flex;
  align-items: center;
  gap: 0;
  background: linear-gradient(145deg, #1C1A12 0%, #131108 100%);
  border: 1rpx solid rgba(212,175,55,0.18);
  border-radius: 20rpx;
  padding: 0 32rpx 0 36rpx;
  height: 112rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.6);
}

/* 左边金色竖线 */
.table-row::before {
  content: '';
  position: absolute;
  left: 28rpx;
  width: 6rpx;
  height: 52rpx;
  background: linear-gradient(to bottom, #D4AF37, #8B6914);
  border-radius: 3rpx;
  margin-left: 0;
}

.table-row {
  position: relative;
}

.row-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #F0E8CC;
  letter-spacing: 2rpx;
  padding-left: 16rpx;
}

.row-count {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 28rpx;
}

.row-count-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #C8A84A;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

/* ===== 预约按钮 ===== */
.row-btn {
  flex-shrink: 0;
  height: 68rpx;
  min-width: 120rpx;
  padding: 0 28rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-btn-text {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.row-btn--open {
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  box-shadow: 0 4rpx 14rpx rgba(212,175,55,0.4);
}

.row-btn--open .row-btn-text { color: #0C0B09; }

.row-btn--queue {
  background: rgba(212,175,55,0.08);
  border: 1rpx solid rgba(212,175,55,0.25);
}

.row-btn--queue .row-btn-text { color: #7A6830; }

.row-btn--booked {
  background: rgba(76,175,80,0.1);
  border: 1rpx solid rgba(76,175,80,0.3);
}

.row-btn--booked .row-btn-text { color: #5A9E5D; }
