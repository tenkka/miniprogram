page { background: #1A1A1A; }

.hall-container {
  min-height: 100vh;
  background: #1A1A1A;
  padding-bottom: 60rpx;
}

/* ===== 顶部 ===== */
.hall-header {
  background: linear-gradient(150deg, #1A1A1A 0%, #2C0E0E 50%, #8B2020 100%);
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.hall-header::after {
  content: '♠♣';
  position: absolute;
  right: -10rpx;
  bottom: -30rpx;
  font-size: 260rpx;
  color: rgba(255,255,255,0.04);
  line-height: 1;
  pointer-events: none;
}

.header-content {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.hall-title-area { display: flex; flex-direction: column; gap: 8rpx; }

.hall-suits { font-size: 24rpx; color: #D4AF37; letter-spacing: 6rpx; }

.hall-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  text-shadow: 0 0 40rpx rgba(212,175,55,0.3);
}

.hall-stats { display: flex; align-items: center; gap: 28rpx; }

.stat-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }

.stat-val { font-size: 48rpx; font-weight: 800; color: rgba(255,255,255,0.7); }
.stat-val.gold { color: #D4AF37; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.45); }

.stat-divider { width: 2rpx; height: 60rpx; background: rgba(255,255,255,0.15); }

/* ===== 状态页 ===== */
.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 32rpx; color: #888; font-weight: 600; }
.empty-sub { font-size: 26rpx; color: #555; }

/* ===== 桌台块 ===== */
.tables-list {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.table-block {
  background: #222;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
  padding-bottom: 40rpx;
}

.block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 0;
}

.block-table-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

/* ===== 桌台可视化 ===== */
.table-stage {
  position: relative;
  width: 750rpx;
  height: 460rpx;
}

.oval-table {
  position: absolute;
  width: 340rpx;
  height: 200rpx;
  background: linear-gradient(145deg, #2A1A0A, #1A0F0F);
  border: 4rpx solid rgba(212,175,55,0.3);
  border-radius: 100rpx;
  left: 205rpx;
  top: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 60rpx rgba(139,32,32,0.2), inset 0 0 40rpx rgba(0,0,0,0.4);
}

.oval-name {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(212,175,55,0.7);
  letter-spacing: 4rpx;
}

/* ===== 座位 ===== */
.seat {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.seat-empty     { background: #2A2A2A; border-color: #3A3A3A; }
.seat-pending   { background: #1A1500; border-color: #D4AF37; box-shadow: 0 0 20rpx rgba(212,175,55,0.4); }
.seat-confirmed { background: #001A08; border-color: #4CAF50; box-shadow: 0 0 20rpx rgba(76,175,80,0.4); }

.seat-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }

/* ===== 图例（顶部） ===== */
.legend-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #888; }

.dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.dot-pending   { background: #D4AF37; }
.dot-confirmed { background: #4CAF50; }


/* ===== 预约弹窗 ===== */
.join-form { padding: 24rpx 40rpx 60rpx; }

.form-drag-bar {
  width: 80rpx; height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  margin: 0 auto 40rpx;
}

.form-title { font-size: 36rpx; font-weight: 700; color: #FFFFFF; text-align: center; margin-bottom: 12rpx; }

.form-subtitle { display: flex; justify-content: center; align-items: center; gap: 8rpx; margin-bottom: 40rpx; }
.subtitle-table { font-size: 26rpx; color: #888; }
.subtitle-dot { color: #444; }
.subtitle-seats { font-size: 26rpx; color: #D4AF37; }

.form-item { margin-bottom: 28rpx; }

.form-label { font-size: 26rpx; color: #888; margin-bottom: 12rpx; display: block; }

.required { color: #8B2020; }
