page { background: #0C0B09; }

.page {
  min-height: 100vh;
  background: #0C0B09;
}

/* ===== 日期条 ===== */
.date-scroll {
  white-space: nowrap;
  background: #0F0E0B;
  border-bottom: 1rpx solid rgba(212,175,55,0.12);
  padding: 20rpx 0;
}

.date-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 28rpx 0 28rpx;
  padding-right: 28rpx;
}

.date-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
  min-width: 88rpx;
  background: transparent;
}

.date-chip--today .date-week {
  color: #D4AF37;
}

.date-chip--on {
  background: rgba(212,175,55,0.12);
  border-color: #D4AF37;
}

.date-week {
  font-size: 22rpx;
  color: #555;
}

.date-chip--on .date-week {
  color: rgba(212,175,55,0.8);
}

.date-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #444;
  font-variant-numeric: tabular-nums;
}

.date-chip--on .date-num {
  color: #E8C94A;
}

/* ===== 内容区 ===== */
.body {
  padding: 32rpx 28rpx;
}

/* ===== 空 / 加载状态 ===== */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
  gap: 20rpx;
}

.state-text {
  font-size: 28rpx;
  color: #444;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #555;
  letter-spacing: 1rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #383428;
}

/* ===== 活动卡片 ===== */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card {
  display: flex;
  gap: 0;
  background: linear-gradient(145deg, #1C1A12 0%, #131108 100%);
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.6);
}

.activity-card-left {
  width: 8rpx;
  background: linear-gradient(to bottom, #D4AF37, #B8941F);
  flex-shrink: 0;
}

.activity-card-body {
  flex: 1;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.activity-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F0E8CC;
  flex: 1;
}

.activity-tag {
  font-size: 20rpx;
  color: #D4AF37;
  background: rgba(212,175,55,0.12);
  border: 1rpx solid rgba(212,175,55,0.3);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

.activity-time-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.activity-time-icon { font-size: 24rpx; }

.activity-time {
  font-size: 26rpx;
  color: #D4AF37;
  font-weight: 600;
}

.activity-desc {
  font-size: 26rpx;
  color: #7A6E58;
  line-height: 1.7;
}
