<view class="page-container">
  <!-- 店铺信息卡片 -->
  <view class="shop-card">
    <van-cell 
      icon="location-o" 
      title="{{shopInfo.name}}" 
      label="{{shopInfo.address}}" 
      is-link 
      url="/pages/shop/select?type=pay" 
      custom-class="shop-cell"
    />
  </view>

  <form bindsubmit="bindSave" report-submit="true">
    <!-- 金额输入卡片 -->
    <view class="amount-card">
      <view class="amount-header">
        <view class="header-icon">💰</view>
        <view class="header-title">消费金额</view>
      </view>
      
      <view class="amount-input-wrapper">
        <view class="currency-symbol">¥</view>
        <input 
          class='amount-input' 
          placeholder='请询问服务员后输入' 
          name="amount" 
          type="digit"
          placeholder-class="input-placeholder"
        ></input>
      </view>

      <view class="pay-button-wrapper">
        <button class="pay-button" formType="submit">
          <view class="button-content">
            <text class="button-text">确认付款</text>
            <text class="button-icon">→</text>
          </view>
        </button>
      </view>
    </view>

    <!-- 优惠规则卡片 -->
    <view class="discount-card" wx:if="{{rechargeSendRules && rechargeSendRules.length > 0}}">
      <view class="discount-header">
        <view class="header-left">
          <view class="discount-icon">🎁</view>
          <view class="discount-title">优惠信息</view>
        </view>
        <view class="discount-badge">限时优惠</view>
      </view>

      <view class="discount-list">
        <block wx:for='{{rechargeSendRules}}' wx:key="index" wx:for-item="item">
          <view class="discount-item">
            <view class="discount-item-top">
              <view class="discount-amount">¥{{item.discounts}}</view>
              <view class="discount-label">优惠</view>
            </view>
            <view class="discount-divider"></view>
            <view class="discount-item-bottom">
              <text class="discount-rule">满¥{{item.consume}}可用</text>
            </view>
          </view>
        </block>
      </view>
    </view>
  </form>

  <!-- 温馨提示 -->
  <view class="tips-card">
    <view class="tips-icon">💡</view>
    <view class="tips-text">消费满额即可享受相应优惠，余额不足将使用微信支付</view>
  </view>
</view>


<payment
  money="{{ money }}"
  remark="优惠买单 ：{{ money }}"
  nextAction="{{ nextAction }}"
  show="{{ paymentShow }}"
  bind:cancel="paymentCancel"
  bind:ok="paymentOk"
/>