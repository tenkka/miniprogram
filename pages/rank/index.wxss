page { background: #1A1A1A; }

.rank-container { min-height: 100vh; background: #1A1A1A; }

.tab-content { padding: 32rpx 24rpx; }

.empty-tip { text-align: center; color: #666; font-size: 28rpx; padding: 120rpx 0; }

/* 前三名 */
.top3-row {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 32rpx;
  padding: 40rpx 0 48rpx;
}
.top3-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.top3-medal { font-size: 56rpx; margin-bottom: 12rpx; }
.top3-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid #D4AF37;
  margin-bottom: 12rpx;
}
.top3-avatar--first {
  width: 144rpx;
  height: 144rpx;
}
.top3-first {
  margin-bottom: 48rpx;
}
.top3-name {
  font-size: 26rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}
.top3-score {
  font-size: 32rpx;
  font-weight: 700;
}
.top3-score.gold { color: #D4AF37; }
.score-unit { font-size: 22rpx; font-weight: 400; margin-left: 4rpx; }

/* 排行列表 */
.rank-list {
  background: #2C2C2C;
  border-radius: 24rpx;
  overflow: hidden;
}
.rank-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.rank-row:last-child { border-bottom: none; }
.rank-no {
  width: 48rpx;
  font-size: 28rpx;
  color: #888888;
  font-weight: 600;
  text-align: center;
  margin-right: 24rpx;
}
.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}
.rank-info { flex: 1; }
.rank-name { font-size: 28rpx; color: #FFFFFF; font-weight: 500; }
.rank-tag {
  font-size: 22rpx;
  color: #888888;
  margin-top: 4rpx;
}
.rank-score {
  font-size: 28rpx;
  color: #D4AF37;
  font-weight: 600;
}
