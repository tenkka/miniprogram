<van-empty wx:if="{{ !paySuccess && !orderInfo }}" description="暂无菜品" />

<block wx:if="{{ !paySuccess && orderInfo }}">
  <!-- 顶部桌号区域 -->
  <view class="header-section">
    <view class="table-card">
      <view class="table-icon">🪑</view>
      <view class="table-info">
        <view class="table-label">桌号</view>
        <view class="table-number">{{ orderInfo.tableCode }}</view>
      </view>
    </view>
  </view>

  <!-- 已点菜品标题 -->
  <view class="section-title">
    <view class="title-line"></view>
    <view class="title-text">已点菜品</view>
    <view class="title-line"></view>
  </view>

  <!-- 菜品列表 -->
  <view class="goods-container">
    <view class="goods-item" wx:for="{{goodsList}}" wx:key="id">
      <view class="goods-image-wrap">
        <image class="goods-image" src="{{ item.pic }}" mode="aspectFill" />
        <!-- 状态角标 -->
        <view class="status-badge status-{{ item.cyTableStatus }}">
          <text wx:if="{{ item.cyTableStatus == 0 }}">待确认</text>
          <text wx:if="{{ item.cyTableStatus == 1 }}">已下厨</text>
          <text wx:if="{{ item.cyTableStatus == 2 }}">已上菜</text>
        </view>
      </view>
      <view class="goods-info">
        <view class="goods-name">{{ item.goodsName }}</view>
        <view class="goods-property" wx:if="{{ item.property }}">{{ item.property }}</view>
        <view class="goods-bottom">
          <view class="goods-price">¥{{ item.amount }}</view>
          <view class="goods-quantity">x{{ item.number }}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 价格统计区域 -->
  <view class="price-summary">
    <view class="summary-item">
      <view class="summary-label">菜品数量</view>
      <view class="summary-value">{{ orderInfo.goodsNumber }} 份</view>
    </view>
    <view class="summary-item">
      <view class="summary-label">消费金额</view>
      <view class="summary-value">¥{{ orderInfo.amount }}</view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item summary-total">
      <view class="summary-label">应付金额</view>
      <view class="summary-value-total">¥{{ orderInfo.amountReal }}</view>
    </view>
  </view>

  <view class="bottom-safe"></view>
  
  <!-- 底部结账栏 -->
  <view class="checkout-bar">
    <view class="checkout-total">
      <view class="checkout-label">合计</view>
      <view class="checkout-price">¥{{ orderInfo.amountReal }}</view>
    </view>
    <view class="checkout-button" bindtap="goPayOrder">
      <text>结账买单</text>
    </view>
  </view>
</block>

<!-- 支付成功页面 -->
<view wx:if="{{ paySuccess }}" class="pay-success-page">
  <view class="success-animation">
    <view class="success-circle">
      <van-icon name="checked" size="120rpx" color="#fff" />
    </view>
  </view>
  <view class="success-title">支付成功</view>
  <view class="success-subtitle">感谢您的光临</view>
</view>

<payment
  money="{{ money }}"
  remark="优惠买单"
  nextAction="{{ nextAction }}"
  show="{{ paymentShow }}"
  bind:cancel="paymentCancel"
  bind:ok="paymentOk"
/>