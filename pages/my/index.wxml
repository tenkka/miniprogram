  <!-- 每周签到卡片 -->
  <view wx:if="{{isLogined}}" class="checkin-section">
    <view class="checkin-header">
      <view class="checkin-header-left">
        <text class="checkin-section-title">每周签到</text>
        <van-icon name="question-o" size="32rpx" color="#555" bindtap="showCheckInRule" />
        <text class="checkin-streak-tag">本周第 {{checkInStreak}} 次</text>
      </view>
      <view
        class="checkin-action-btn {{checkInDone ? 'checkin-action-btn--done' : ''}} {{checkingIn ? 'checkin-action-btn--loading' : ''}}"
        bindtap="doCheckIn"
      >
        <text class="checkin-action-text">{{checkingIn ? '签到中' : checkInDone ? '已签到' : '+' + checkInPoints + '积分'}}</text>
      </view>
    </view>

    <!-- 周历 -->
    <view class="cal-week">
      <view wx:for="{{calendarDays}}" wx:key="dateStr" class="cal-col">
        <text class="cal-label {{item.isToday ? 'cal-label--today' : ''}}">{{item.label}}</text>
        <view class="cal-circle cal-circle--{{item.circleType}}">
          <text class="cal-date cal-date--{{item.circleType}}">{{item.dateNum}}</text>
          <view wx:if="{{item.checked}}" class="cal-check">✓</view>
        </view>
      </view>
    </view>
  </view>

