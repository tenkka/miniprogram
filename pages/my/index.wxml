<view class="page-container">
  <!-- 顶部背景区域（已登录时含用户卡片） -->
  <view class="header-section {{isLogined ? '' : 'header-section-short'}}">
    <image mode='aspectFill' class='header-bg' src='{{myBg}}'></image>
    <view class="header-gradient"></view>

    <!-- 已登录：用户信息卡片 -->
    <view wx:if="{{isLogined}}" class="user-card">
      <view class="user-info-row">
        <view class="avatar-section">
          <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onAvatarChoose">
            <image src="{{ apiUserInfoMap.base.avatarUrl ? apiUserInfoMap.base.avatarUrl : '/images/default.png' }}" mode="aspectFill" class="avatar-img"></image>
            <view class="avatar-ring"></view>
          </button>
        </view>

        <view class="user-details">
          <view class="nickname-row">
            <view class="nickname" bindtap="editNick">
              {{ nick ? nick : '点击设置昵称' }}
            </view>
            <view wx:if="{{openidShort}}" class="qr-icon-btn" bindtap="showQRCode">
              <van-icon name="qr" size="72rpx" color="#D4AF37" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 未登录：登录卡片（流式布局，不受 header 高度限制） -->
  <view wx:if="{{!isLogined}}" class="login-card">
    <view class="login-avatar-placeholder">
      <van-icon name="contact" size="96rpx" color="#666666" />
    </view>
    <view class="login-title">欢迎来到 NUTS</view>
    <view class="login-sub">登录后查看余额、订单、优惠券</view>
    <button class="login-wechat-btn" bindtap="doLogin">
      <text class="login-btn-text">微信一键登录</text>
    </button>
  </view>

  <!-- 资产卡片区域 -->
