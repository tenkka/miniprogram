<!-- 登录 popup -->
<van-popup show="{{loginPopupShow}}" position="bottom" round bind:close="closeLoginPopup"
  safe-area-inset-bottom safe-area-tab-bar
  custom-style="background:#1A1A1A;padding:48rpx 40rpx 48rpx;">
  <view class="lp-title">加入 NUTS</view>
  <view class="lp-sub">选择头像和昵称开始游戏</view>
  <button class="lp-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onPickAvatar">
    <image class="lp-avatar-img" src="{{pendingAvatar || '/images/who.png'}}" mode="aspectFill"/>
    <view class="lp-camera">📷</view>
  </button>
  <input class="lp-nick-input" type="nickname" placeholder="输入昵称（可直接使用微信昵称）" placeholder-class="lp-placeholder" value="{{pendingNick}}" bindinput="onNickInput" bindchange="onNickChange" maxlength="20" />
  <button class="lp-confirm-btn" loading="{{loginLoading}}" bindtap="confirmLogin">完成登录</button>
</van-popup>

<!-- 后台管理验证弹窗 -->
<van-popup show="{{adminPopupShow}}" position="bottom" round bind:close="closeAdminPopup" custom-style="background:#252525;padding:40rpx 40rpx 80rpx;min-height:50vh;">
  <view class="admin-drag-bar"></view>
  <view class="admin-popup-title">后台管理</view>
  <view class="admin-popup-sub">请输入管理员密码</view>
  <input
    class="admin-pass-input"
    password
    value="{{adminPassword}}"
    placeholder="密码"
    placeholder-style="color:#555;"
    bindinput="onAdminPasswordInput"
  />
  <van-button
    type="primary" block loading="{{adminVerifying}}" bind:click="confirmAdmin"
    custom-style="background:linear-gradient(135deg,#8B2020,#C8952A);border:none;border-radius:48rpx;height:96rpx;font-size:32rpx;font-weight:600;letter-spacing:4rpx;"
  >进入后台</van-button>
</van-popup>

<!-- 签到规则弹窗 -->
<van-popup show="{{checkInRuleShow}}" position="bottom" round bind:close="closeCheckInRule" custom-style="background:#252525;padding:40rpx 40rpx 72rpx;">
  <view class="rule-drag-bar"></view>
  <view class="rule-title">签到规则与奖励</view>

  <view class="rule-section-label">奖励积分</view>
  <view class="rule-reward-grid">
    <view class="rule-reward-item" wx:for="{{[{d:1,p:10},{d:2,p:20},{d:3,p:30},{d:4,p:40},{d:5,p:60},{d:6,p:80},{d:7,p:100}]}}" wx:key="d">
      <view class="rule-reward-day {{item.d === checkInStreak ? 'rule-reward-day--current' : ''}}">
        <text class="rule-reward-day-num">第{{item.d}}天</text>
      </view>
      <text class="rule-reward-pts {{item.d === checkInStreak ? 'rule-reward-pts--current' : ''}}">+{{item.p}}</text>
    </view>
  </view>

  <view class="rule-section-label" style="margin-top:32rpx;">签到规则</view>
  <view class="rule-list">
    <view class="rule-item">
      <view class="rule-dot"></view>
      <text class="rule-text">每天可签到一次，积分实时加入个人战力值</text>
    </view>
    <view class="rule-item">
      <view class="rule-dot"></view>
      <text class="rule-text">本周签到次数越多，当次获得的积分越高</text>
    </view>
    <view class="rule-item">
      <view class="rule-dot"></view>
      <text class="rule-text">断签不影响本周内的签到计数，无需连续</text>
    </view>
    <view class="rule-item">
      <view class="rule-dot"></view>
      <text class="rule-text">每周（周一至周日）结束后签到进度自动重置</text>
    </view>
  </view>
</van-popup>

<!-- 二维码弹窗 -->
<van-popup show="{{qrShow}}" round bind:close="closeQR" custom-style="background:#1A1710;padding:48rpx 48rpx 56rpx;">
  <view class="qr-popup-drag"></view>
  <view class="qr-popup-title">我的专属二维码</view>
  <view class="qr-popup-sub">扫描后可在后台识别身份</view>
  <view class="qr-img-wrap">
    <van-loading wx:if="{{qrGenerating || !qrCodePath}}" color="#D4AF37" size="48rpx" />
    <image wx:else class="qr-img" src="{{qrCodePath}}" mode="aspectFit" />
  </view>
  <view class="qr-popup-tip">二维码仅本次有效，包含当前时间戳</view>
</van-popup>

<!-- 编辑昵称弹窗 -->
<van-popup show="{{ nickShow }}" position="bottom" round bind:close="closeNickDialog"
  safe-area-inset-bottom safe-area-tab-bar
  custom-style="background:#252525;padding:40rpx 40rpx 48rpx;">
  <view class="nick-drag-bar"></view>
  <view class="nick-popup-title">修改昵称</view>
  <input
    class="nick-edit-input"
    type="nickname"
    value="{{ pendingNick }}"
    placeholder="请填写昵称"
    placeholder-style="color:#555;"
    bindinput="onPendingNickInput"
    bindchange="onPendingNickChange"
    maxlength="20"
    focus="{{ nickShow }}"
  />
  <van-button
    type="primary" block bind:click="_editNick"
    custom-style="background:linear-gradient(135deg,#8B2020,#C8952A);border:none;border-radius:48rpx;height:96rpx;font-size:32rpx;font-weight:600;letter-spacing:4rpx;"
  >保存昵称</van-button>
</van-popup>
