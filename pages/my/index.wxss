/* ===== 签到卡片 ===== */
.checkin-section {
  margin: 20rpx 28rpx 0;
  background: #252525;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 24rpx;
  border: 1rpx solid rgba(212,175,55,0.15);
}

.checkin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.checkin-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkin-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.checkin-streak-tag {
  font-size: 22rpx;
  color: #D4AF37;
  background: rgba(212,175,55,0.12);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.checkin-action-btn {
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
}

.checkin-action-btn--done {
  background: rgba(255,255,255,0.06);
}

.checkin-action-btn--loading {
  opacity: 0.6;
}

.checkin-action-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.checkin-action-btn--done .checkin-action-text {
  color: #555;
}

/* 周历 */
.cal-week {
  display: flex;
  justify-content: space-between;
}

.cal-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.cal-label {
  font-size: 22rpx;
  color: #666;
}

.cal-label--today {
  color: #D4AF37;
  font-weight: 600;
}

.cal-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  position: relative;
}

.cal-circle--past {
  background: rgba(255,255,255,0.04);
  border-color: rgba(255,255,255,0.08);
}

.cal-circle--future {
  background: rgba(255,255,255,0.02);
  border-color: rgba(255,255,255,0.04);
}

.cal-circle--today {
  background: rgba(212,175,55,0.08);
  border-color: #D4AF37;
  border-width: 2rpx;
}

.cal-circle--checked {
  background: rgba(212,175,55,0.18);
  border-color: rgba(212,175,55,0.5);
}

.cal-circle--today-checked {
  background: #D4AF37;
  border-color: #D4AF37;
}

.cal-date {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.cal-date--past    { color: #888; }
.cal-date--future  { color: #444; }
.cal-date--today   { color: #D4AF37; }
.cal-date--checked { color: #D4AF37; }
.cal-date--today-checked { color: #1A1A1A; }

.cal-check {
  font-size: 16rpx;
  line-height: 1;
  color: #D4AF37;
  margin-top: 2rpx;
}

.cal-circle--today-checked .cal-check {
  color: #1A1A1A;
}

/* ===== 签到规则弹窗 ===== */
.rule-drag-bar {
  width: 72rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 4rpx;
  margin: 0 auto 36rpx;
}

.rule-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 32rpx;
}

.rule-section-label {
  font-size: 22rpx;
  color: #666;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.rule-reward-grid {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.rule-reward-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.rule-reward-day {
  width: 100%;
  padding: 10rpx 0;
  background: rgba(255,255,255,0.04);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.rule-reward-day--current {
  background: rgba(212,175,55,0.15);
  border-color: rgba(212,175,55,0.4);
}

.rule-reward-day-num {
  font-size: 18rpx;
  color: #888;
}

.rule-reward-day--current .rule-reward-day-num {
  color: #D4AF37;
  font-weight: 600;
}

.rule-reward-pts {
  font-size: 24rpx;
  font-weight: 700;
  color: #555;
}

.rule-reward-pts--current {
  color: #D4AF37;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rule-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D4AF37;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #AAAAAA;
  line-height: 1.7;
  flex: 1;
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #1A1A1A;
  padding-bottom: 40rpx;
}

/* ==================== 顶部区域 ==================== */
.header-section {
  position: relative;
  width: 100%;
  height: 280rpx;
  overflow: hidden;
}

.header-section-short {
  height: 160rpx;
}

.header-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  filter: blur(20rpx);
  opacity: 0.9;
  z-index: 9;
}

.header-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg,
    rgba(26, 26, 26, 0.85) 0%,
    rgba(44, 14, 14, 0.88) 50%,
    rgba(139, 32, 32, 0.9) 100%
  );
}

/* ==================== 未登录卡片 ==================== */
.login-card {
  margin: 24rpx 32rpx 32rpx;
  background: #2C2C2C;
  border-radius: 32rpx;
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.login-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #3A3A3A;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.login-sub {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 36rpx;
  text-align: center;
}

.login-wechat-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  padding: 0;
}

.login-wechat-btn::after {
  border: none;
}

.login-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ==================== 用户信息卡片 ==================== */
.user-card {
  position: absolute;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  background: #2C2C2C;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  z-index: 10;
}

.user-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  margin-right: 24rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  overflow: visible;
  position: relative;
  z-index: 2;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.2);
}

.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background: linear-gradient(135deg, #FFD700, #FFA500, #FF8C00);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  padding: 3rpx;
  animation: rotate 3s linear infinite;
  z-index: 1;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 用户详情 */
.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.uid-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.uid-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 8rpx;
}

.uid-value {
  font-size: 24rpx;
  color: #666666;
  font-family: 'Courier New', monospace;
}

.vip-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 20rpx;
  align-self: flex-start;
}

.vip-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 二维码区域 */
.qr-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
}

.qr-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE4B5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 115, 85, 0.15);
}

.qr-text {
  font-size: 22rpx;
  color: #8B7355;
  font-weight: 500;
}

/* ==================== 资产卡片区域 ==================== */
.assets-section {
  margin: 96rpx 32rpx 32rpx;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
}

.asset-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.asset-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #FFD700 0%, #FFA500 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.asset-card:active::before {
  opacity: 1;
}

.highlight-card {
  background: linear-gradient(135deg, #8B7355 0%, #A0826D 100%);
  box-shadow: 0 8rpx 24rpx rgba(139, 115, 85, 0.3);
}

.highlight-card .asset-label,
.highlight-card .asset-value,
.highlight-card .asset-value-large {
  color: #FFFFFF !important;
}

.asset-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.coupon-icon {
  background: linear-gradient(135deg, #FFE4B5 0%, #FFD7A3 100%);
}

.balance-icon {
  background: rgba(255, 255, 255, 0.25);
}

.score-icon {
  background: linear-gradient(135deg, #FFF8DC 0%, #FFEAA7 100%);
}

.asset-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.asset-value-large {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.currency {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-right: 4rpx;
}

.amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.asset-label {
  font-size: 24rpx;
  color: #999999;
}

/* ==================== 功能菜单区域 ==================== */
.menu-section {
  padding: 0 32rpx;
}

.menu-group {
  margin-bottom: 32rpx;
}

.menu-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.title-dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8B7355 0%, #A0826D 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.menu-title text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 网格菜单 */
.menu-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.menu-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.menu-item navigator {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.menu-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(139, 115, 85, 0.15);
}

.menu-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
}

.scan-icon {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  color: #2196F3;
}

.sign-icon {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD0 100%);
  color: #E91E63;
}

.booking-icon {
  background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%);
  color: #9C27B0;
}

.pay-icon {
  background: linear-gradient(135deg, #FFF9C4 0%, #FFF59D 100%);
  color: #FFA000;
}

.menu-text {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
  line-height: 1.4;
}

/* 列表菜单 */
.menu-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.menu-list navigator {
  display: block;
}

.menu-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background 0.3s ease;
}

.menu-list-item:last-child {
  border-bottom: none;
}

.menu-list-item:active {
  background: #FAFAFA;
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.list-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.vip-icon {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  color: #FFA000;
}

.order-icon {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  color: #4CAF50;
}

.address-icon {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  color: #2196F3;
}

.about-icon {
  background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%);
  color: #9C27B0;
}

.service-icon {
  background: linear-gradient(135deg, #E0F2F1 0%, #B2DFDB 100%);
  color: #009688;
}

.feedback-icon {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  color: #FF9800;
}

.clear-icon {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
  color: #F44336;
}

.admin-icon {
  background: linear-gradient(135deg, #F5F5F5 0%, #E0E0E0 100%);
  color: #757575;
}

.phone-icon {
  background: linear-gradient(135deg, #E8EAF6 0%, #C5CAE9 100%);
  color: #3F51B5;
}

.lottery-icon {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  color: #FB8C00;
}

.invite-icon {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD0 100%);
  color: #E91E63;
}

.phone-right {
  display: flex;
  align-items: center;
}

.list-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* ==================== 版本信息 ==================== */
.version-text {
  text-align: center;
  margin-top: 48rpx;
  padding-bottom: 32rpx;
  color: #BDBDBD;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* ==================== 兼容旧样式 ==================== */
.userinfo, .uploader, .tunnel {
  display: none;
}

.userinfo-avatar {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  overflow: visible;
}

.userinfo-avatar::after {
  border: none;
}

.userinfo-avatar-img {
  display: none;
}

.userinfo-nickname {
  display: none;
}

.userinfo-nickname::after {
  border: none;
}

/* ===== 登录 popup ===== */
.lp-title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; text-align: center; margin-bottom: 8rpx; }
.lp-sub { font-size: 24rpx; color: #888; text-align: center; margin-bottom: 48rpx; }
.lp-avatar-btn { width: 160rpx; height: 160rpx; border-radius: 50%; padding: 0; margin: 0 auto 32rpx; background: transparent; border: none; position: relative; display: block; }
.lp-avatar-btn::after { border: none; }
.lp-avatar-img { width: 160rpx; height: 160rpx; border-radius: 50%; border: 4rpx solid #D4AF37; }
.lp-camera { position: absolute; bottom: 0; right: 0; width: 48rpx; height: 48rpx; background: #D4AF37; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.lp-nick-input { width: 100%; height: 88rpx; background: #2C2C2C; border-radius: 20rpx; padding: 0 28rpx; font-size: 30rpx; color: #FFFFFF; border: 2rpx solid rgba(212,175,55,0.2); margin-bottom: 32rpx; box-sizing: border-box; }
.lp-placeholder { color: #555; }
.lp-confirm-btn { width: 100%; height: 96rpx; background: linear-gradient(135deg, #D4AF37, #B8941F); border-radius: 48rpx; font-size: 34rpx; font-weight: 700; color: #1A1A1A; border: none; box-shadow: 0 12rpx 40rpx rgba(212,175,55,0.4); }
.lp-confirm-btn::after { border: none; }

/* ===== 修改昵称弹窗 ===== */
.nick-drag-bar { width: 80rpx; height: 8rpx; background: rgba(255,255,255,0.2); border-radius: 4rpx; margin: 0 auto 40rpx; }
.nick-popup-title { font-size: 36rpx; font-weight: 700; color: #FFFFFF; text-align: center; margin-bottom: 32rpx; }
.nick-edit-input { width: 100%; height: 88rpx; background: #1A1A1A; border-radius: 16rpx; padding: 0 28rpx; font-size: 30rpx; color: #FFFFFF; border: 2rpx solid rgba(212,175,55,0.2); margin-bottom: 32rpx; box-sizing: border-box; }

/* ===== 后台管理验证弹窗 ===== */
.admin-drag-bar { width: 80rpx; height: 8rpx; background: rgba(255,255,255,0.2); border-radius: 4rpx; margin: 0 auto 40rpx; }
.admin-popup-title { font-size: 36rpx; font-weight: 700; color: #FFFFFF; text-align: center; margin-bottom: 8rpx; }
.admin-popup-sub { font-size: 24rpx; color: #888; text-align: center; margin-bottom: 32rpx; }
.admin-pass-input { width: 100%; height: 88rpx; background: #1A1A1A; border-radius: 16rpx; padding: 0 28rpx; font-size: 30rpx; color: #FFFFFF; border: 2rpx solid rgba(212,175,55,0.2); margin-bottom: 32rpx; box-sizing: border-box; }
