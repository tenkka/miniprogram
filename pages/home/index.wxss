page { background: #F0EEEB; }

.home-container {
  min-height: 100vh;
  background: #F0EEEB;
  padding-bottom: 120rpx;
}

/* ===== Hero ===== */
.hero-section {
  position: relative;
  width: 100%;
  height: 56.25vw;
  min-height: 360rpx;
  overflow: hidden;
  background: #1A1108;
}

.hero-bg {
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.hero-swiper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-swiper-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0) 40%, rgba(240,238,235,0.6) 100%);
  pointer-events: none;
}

/* ===== 门店条 ===== */
.store-strip {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.store-strip-icon { font-size: 32rpx; flex-shrink: 0; }

.store-strip-info {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.store-strip-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.store-strip-addr {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-strip-arrow {
  font-size: 40rpx;
  color: #E8749A;
  flex-shrink: 0;
}

/* ===== 招商/会员卡 ===== */
.member-card {
  margin: 20rpx 24rpx 0;
  background: linear-gradient(135deg, #FCE4EA 0%, #F9C0CE 100%);
  border-radius: 24rpx;
  padding: 24rpx 28rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(232,116,154,0.15);
}

.member-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.member-card-tag {
  font-size: 36rpx;
  font-weight: 900;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.member-detail-btn {
  background: rgba(255,255,255,0.55);
  border-radius: 32rpx;
  padding: 8rpx 24rpx;
}

.member-detail-text {
  font-size: 22rpx;
  color: #555;
}

.member-card-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.member-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-welcome {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.member-stats {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.member-stat {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-stat-label {
  font-size: 20rpx;
  color: #888;
}

.member-stat-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;
}

.member-stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.12);
}

.member-trophy {
  font-size: 100rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* ===== 两大入口卡 ===== */
.main-cards {
  margin: 20rpx 24rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.main-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 3rpx solid #1A1A1A;
  padding: 28rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 5rpx 5rpx 0 #1A1A1A;
  position: relative;
  overflow: hidden;
}

.main-card-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #1A1A1A;
  line-height: 1.2;
}

.main-card-en {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  font-style: italic;
}

.main-card-img {
  width: 150rpx;
  height: 150rpx;
  margin-top: 16rpx;
  align-self: center;
}

/* ===== 4 小入口 ===== */
.mini-grid {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 12rpx 24rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.mini-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.mini-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F5F2EF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-icon {
  width: 60rpx;
  height: 60rpx;
}

.mini-label {
  font-size: 22rpx;
  color: #333;
  text-align: center;
}

/* ===== 底部信息 ===== */
.footer-info {
  margin: 24rpx 24rpx 0;
  background: #1A1A1A;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.footer-phone {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
}

.footer-addrs {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 4rpx;
}

.footer-addr {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
}

.footer-brand {
  font-size: 30rpx;
  font-weight: 800;
  color: #E8749A;
  text-align: center;
  letter-spacing: 4rpx;
  margin-top: 16rpx;
}

/* ===== 签到弹窗 ===== */
.ci-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.75);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.ci-card {
  width: 100%;
  background: linear-gradient(160deg, #1E1B12 0%, #101008 100%);
  border-radius: 32rpx;
  padding: 52rpx 36rpx 44rpx;
  position: relative;
  border: 1rpx solid rgba(212,175,55,0.32);
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.92), 0 1rpx 0 rgba(212,175,55,0.18) inset;
}

.ci-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 48rpx;
  color: #666;
  line-height: 1;
  padding: 8rpx;
}

.ci-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
}

.ci-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ci-row--center { justify-content: center; gap: 12rpx; }

.ci-day {
  flex: 1;
  max-width: 148rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-radius: 16rpx;
  padding: 16rpx 0 14rpx;
  border: 2rpx solid transparent;
}

.ci-day--done { background: rgba(212,175,55,0.14); border-color: rgba(212,175,55,0.5); }
.ci-day--current { background: rgba(212,175,55,0.22); border-color: #E8C94A; box-shadow: 0 0 12rpx rgba(212,175,55,0.2); }
.ci-day--future { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05); }

.ci-star { font-size: 36rpx; line-height: 1; }
.ci-day--done .ci-star, .ci-day--current .ci-star { color: #D4AF37; }
.ci-day--future .ci-star { color: #444; }

.ci-pts { font-size: 20rpx; font-weight: 600; }
.ci-day--done .ci-pts, .ci-day--current .ci-pts { color: #D4AF37; }
.ci-day--future .ci-pts { color: #555; }

.ci-lbl { font-size: 18rpx; }
.ci-day--done .ci-lbl, .ci-day--current .ci-lbl { color: #AAA; }
.ci-day--future .ci-lbl { color: #444; }

.ci-btn {
  margin-top: 32rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ci-btn--done { background: rgba(255,255,255,0.08); }
.ci-btn--loading { opacity: 0.6; }

.ci-btn-text { font-size: 34rpx; font-weight: 700; color: #1A1A1A; letter-spacing: 4rpx; }
.ci-btn--done .ci-btn-text { color: #666; letter-spacing: 2rpx; }

/* ===== 轮播图细则弹窗 ===== */
.bd-wrap { padding: 0 0 120rpx; }
.bd-drag { width: 64rpx; height: 6rpx; background: rgba(212,175,55,0.3); border-radius: 4rpx; margin: 20rpx auto 0; }
.bd-img { width: 100%; display: block; margin-top: 24rpx; }
.bd-close { margin: 40rpx 40rpx 0; height: 88rpx; line-height: 88rpx; text-align: center; background: rgba(212,175,55,0.08); border: 1rpx solid rgba(212,175,55,0.25); border-radius: 44rpx; font-size: 30rpx; color: rgba(212,175,55,0.7); }

/* ===== 登录 popup ===== */
.lp-title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; text-align: center; margin-bottom: 8rpx; }
.lp-sub { font-size: 24rpx; color: #888; text-align: center; margin-bottom: 48rpx; }
.lp-avatar-btn { width: 160rpx; height: 160rpx; border-radius: 50%; padding: 0; margin: 0 auto 32rpx; background: transparent; border: none; position: relative; display: block; }
.lp-avatar-btn::after { border: none; }
.lp-avatar-img { width: 160rpx; height: 160rpx; border-radius: 50%; border: 4rpx solid #E8749A; }
.lp-camera { position: absolute; bottom: 0; right: 0; width: 48rpx; height: 48rpx; background: #E8749A; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.lp-nick-input { width: 100%; height: 88rpx; background: #1A1810; border-radius: 20rpx; padding: 0 28rpx; font-size: 30rpx; color: #FFFFFF; border: 1rpx solid rgba(232,116,154,0.3); margin-bottom: 32rpx; box-sizing: border-box; }
.lp-placeholder { color: #555; }
.lp-confirm-btn { width: 100%; height: 96rpx; background: linear-gradient(135deg, #E8749A, #C8506A); border-radius: 48rpx; font-size: 34rpx; font-weight: 700; color: #FFFFFF; border: none; }
.lp-confirm-btn::after { border: none; }
