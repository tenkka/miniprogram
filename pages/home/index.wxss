page { background: #0C0B09; }

.home-container {
  min-height: 100vh;
  background: #0C0B09;
  padding-bottom: 60rpx;
}

/* ===== Hero ===== */
.hero-section {
  position: relative;
  width: 100%;
  height: 56.25vw;
  min-height: 360rpx;
  overflow: hidden;
  background: #080806;
}

.hero-bg {
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.hero-swiper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-swiper-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.4) 0%,
    rgba(0,0,0,0) 35%,
    rgba(8,7,5,0.85) 100%
  );
  pointer-events: none;
}

/* ===== 当前门店条 ===== */
.store-strip {
  margin: 20rpx 28rpx 0;
  background: linear-gradient(135deg, #1C1A14 0%, #141210 100%);
  border: 1rpx solid rgba(212,175,55,0.22);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.6), 0 1rpx 0 rgba(212,175,55,0.1) inset;
}

.store-strip-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.store-strip-info {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.store-strip-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #F0E8CC;
  letter-spacing: 1rpx;
}

.store-strip-addr {
  font-size: 22rpx;
  color: #7A6E58;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-strip-arrow {
  font-size: 40rpx;
  color: #D4AF37;
  flex-shrink: 0;
  line-height: 1;
}

.hero-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.hero-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 2rpx solid #D4AF37;
}

.login-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}


/* ===== 欢迎卡 ===== */
.welcome-card {
  margin: 24rpx 28rpx 0;
  background: linear-gradient(135deg, #1C1A14 0%, #141210 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(212,175,55,0.22);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.7), 0 1rpx 0 rgba(212,175,55,0.1) inset;
}

.welcome-text {
  font-size: 28rpx;
  color: #C8C0A8;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.welcome-btn {
  background: linear-gradient(135deg, rgba(212,175,55,0.18), rgba(212,175,55,0.08));
  border: 1rpx solid rgba(212,175,55,0.55);
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.welcome-btn-text {
  font-size: 24rpx;
  color: #E8C94A;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ===== 快捷入口大卡 ===== */
.quick-cards {
  margin: 20rpx 28rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-card {
  background: linear-gradient(160deg, #1E1B12 0%, #131108 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(212,175,55,0.25);
  padding: 52rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.85), 0 1rpx 0 rgba(212,175,55,0.18) inset;
  position: relative;
  overflow: hidden;
}

.quick-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent);
}

.quick-card-icon {
  font-size: 88rpx;
  line-height: 1;
}

.quick-card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8D5A0;
  letter-spacing: 4rpx;
}

/* ===== 战力分数条 ===== */
.score-strip {
  margin: 20rpx 28rpx 0;
  background: #252525;
  border-radius: 20rpx;
  border: 1rpx solid rgba(212,175,55,0.15);
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.score-label {
  font-size: 22rpx;
  color: #666;
}

.score-val {
  font-size: 56rpx;
  font-weight: 800;
  color: #D4AF37;
  line-height: 1;
}

.score-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(212,175,55,0.1);
  border: 1rpx solid rgba(212,175,55,0.3);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}

.score-action-text {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: 600;
}

/* ===== 排行榜卡片 ===== */
.section-card {
  margin: 20rpx 28rpx 0;
  background: linear-gradient(135deg, #1C1A14 0%, #141210 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(212,175,55,0.2);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.7), 0 1rpx 0 rgba(212,175,55,0.1) inset;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title-icon { font-size: 34rpx; }

.card-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #D4AF37;
  font-size: 24rpx;
}

.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.02);
}

.rank-col {
  width: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.rank-medal { font-size: 36rpx; }

.rank-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #555;
}

.player-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(212,175,55,0.25);
  flex-shrink: 0;
}

.player-info {
  flex: 1;
  overflow: hidden;
}

.player-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-points {
  text-align: right;
  flex-shrink: 0;
}

.points-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #D4AF37;
}

.points-unit {
  font-size: 20rpx;
  color: #666;
  margin-left: 2rpx;
}

.empty-rank {
  padding: 40rpx 0;
  text-align: center;
}

.empty-rank-text {
  font-size: 26rpx;
  color: #444;
}

/* ===== 底部 ===== */
.brand-footer {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.footer-suits {
  font-size: 26rpx;
  color: rgba(212,175,55,0.45);
  letter-spacing: 10rpx;
}

.footer-name {
  font-size: 20rpx;
  color: rgba(212,175,55,0.2);
  letter-spacing: 6rpx;
}

/* ===== 签到弹窗 ===== */
.ci-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.75);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.ci-card {
  width: 100%;
  background: linear-gradient(160deg, #1E1B12 0%, #101008 100%);
  border-radius: 32rpx;
  padding: 52rpx 36rpx 44rpx;
  position: relative;
  border: 1rpx solid rgba(212,175,55,0.32);
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.92), 0 1rpx 0 rgba(212,175,55,0.18) inset;
}

.ci-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 48rpx;
  color: #666;
  line-height: 1;
  padding: 8rpx;
}

.ci-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
}

.ci-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ci-row--center {
  justify-content: center;
  gap: 12rpx;
}

.ci-day {
  flex: 1;
  max-width: 148rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-radius: 16rpx;
  padding: 16rpx 0 14rpx;
  border: 2rpx solid transparent;
}

.ci-day--done {
  background: rgba(212,175,55,0.14);
  border-color: rgba(212,175,55,0.5);
}

.ci-day--current {
  background: rgba(212,175,55,0.22);
  border-color: #E8C94A;
  box-shadow: 0 0 12rpx rgba(212,175,55,0.2);
}

.ci-day--future {
  background: rgba(255,255,255,0.02);
  border-color: rgba(255,255,255,0.05);
}

.ci-star {
  font-size: 36rpx;
  line-height: 1;
}

.ci-day--done .ci-star,
.ci-day--current .ci-star { color: #D4AF37; }
.ci-day--future .ci-star { color: #444; }

.ci-pts {
  font-size: 20rpx;
  font-weight: 600;
}

.ci-day--done .ci-pts,
.ci-day--current .ci-pts { color: #D4AF37; }
.ci-day--future .ci-pts { color: #555; }

.ci-lbl {
  font-size: 18rpx;
}

.ci-day--done .ci-lbl,
.ci-day--current .ci-lbl { color: #AAA; }
.ci-day--future .ci-lbl { color: #444; }

.ci-btn {
  margin-top: 32rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ci-btn--done {
  background: rgba(255,255,255,0.08);
}

.ci-btn--loading {
  opacity: 0.6;
}

.ci-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 4rpx;
}

.ci-btn--done .ci-btn-text {
  color: #666;
  letter-spacing: 2rpx;
}

/* ===== 轮播图细则弹窗 ===== */
.bd-wrap {
  padding: 0 0 120rpx;
}
.bd-drag {
  width: 64rpx;
  height: 6rpx;
  background: rgba(212,175,55,0.3);
  border-radius: 4rpx;
  margin: 20rpx auto 0;
}
.bd-img {
  width: 100%;
  display: block;
  margin-top: 24rpx;
}
.bd-close {
  margin: 40rpx 40rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: rgba(212,175,55,0.08);
  border: 1rpx solid rgba(212,175,55,0.25);
  border-radius: 44rpx;
  font-size: 30rpx;
  color: rgba(212,175,55,0.7);
}

/* ===== 登录 popup ===== */
.lp-title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; text-align: center; margin-bottom: 8rpx; }
.lp-sub { font-size: 24rpx; color: #888; text-align: center; margin-bottom: 48rpx; }
.lp-avatar-btn { width: 160rpx; height: 160rpx; border-radius: 50%; padding: 0; margin: 0 auto 32rpx; background: transparent; border: none; position: relative; display: block; }
.lp-avatar-btn::after { border: none; }
.lp-avatar-img { width: 160rpx; height: 160rpx; border-radius: 50%; border: 4rpx solid #D4AF37; }
.lp-camera { position: absolute; bottom: 0; right: 0; width: 48rpx; height: 48rpx; background: #D4AF37; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.lp-nick-input { width: 100%; height: 88rpx; background: #1A1810; border-radius: 20rpx; padding: 0 28rpx; font-size: 30rpx; color: #FFFFFF; border: 1rpx solid rgba(212,175,55,0.3); margin-bottom: 32rpx; box-sizing: border-box; }
.lp-placeholder { color: #555; }
.lp-confirm-btn { width: 100%; height: 96rpx; background: linear-gradient(135deg, #D4AF37, #B8941F); border-radius: 48rpx; font-size: 34rpx; font-weight: 700; color: #1A1A1A; border: none; }
.lp-confirm-btn::after { border: none; }
