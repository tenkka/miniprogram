<view class="home-container">

  <!-- Hero 区域 -->
  <view class="hero-section">
    <swiper
      wx:if="{{banners.length > 0}}"
      class="hero-swiper"
      autoplay circular interval="4000" duration="400"
      indicator-dots="{{banners.length > 1}}"
      indicator-color="rgba(255,255,255,0.35)"
      indicator-active-color="#E8749A"
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{banners}}" wx:key="_id">
        <image class="hero-swiper-image" src="{{item.imageUrl}}" mode="aspectFill" bindtap="onBannerTap" data-index="{{index}}" />
      </swiper-item>
    </swiper>
    <image wx:else class="hero-bg" src="/images/logo.jpg" mode="aspectFit" />
    <view class="hero-overlay"></view>
  </view>

  <!-- 当前门店 -->
  <view class="store-strip" bindtap="goStores" wx:if="{{currentStore}}">
    <text class="store-strip-icon">📍</text>
    <view class="store-strip-info">
      <text class="store-strip-name">{{currentStore.name}}</text>
      <text class="store-strip-addr" wx:if="{{currentStore.address}}">{{currentStore.address}}</text>
    </view>
    <text class="store-strip-arrow">›</text>
  </view>

  <!-- 招商/会员卡 -->
  <view class="member-card">
    <view class="member-card-top">
      <text class="member-card-tag">招商</text>
      <view class="member-detail-btn" bindtap="goRecruit">
        <text class="member-detail-text">了解详情</text>
      </view>
    </view>
    <view class="member-card-body">
      <view class="member-info">
        <text class="member-welcome">欢迎回来 {{nick || '朋友'}}</text>
        <view class="member-stats">
          <view class="member-stat">
            <text class="member-stat-label">积分</text>
            <text class="member-stat-val">{{userPoints}}</text>
          </view>
          <view class="member-stat-divider"></view>
          <view class="member-stat">
            <text class="member-stat-label">称号</text>
            <text class="member-stat-val">{{userTitle || 'NUTS会员'}}</text>
          </view>
        </view>
      </view>
      <text class="member-trophy">🏆</text>
    </view>
  </view>

  <!-- 两大入口卡 -->
  <view class="main-cards">
    <view class="main-card" bindtap="goOrder">
      <text class="main-card-title">店内下单</text>
      <text class="main-card-en">In-store</text>
      <image class="main-card-img" src="/images/icon/SVG/order.svg" mode="aspectFit" />
    </view>
    <view class="main-card" bindtap="goShop">
      <text class="main-card-title">核心商城</text>
      <text class="main-card-en">Rewards Center</text>
      <image class="main-card-img" src="/images/icon/SVG/shop.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 4 小入口 -->
  <view class="mini-grid">
    <view class="mini-item" bindtap="goActivities">
      <view class="mini-icon-wrap">
        <image class="mini-icon" src="/images/icon/SVG/event.svg" mode="aspectFit" />
      </view>
      <text class="mini-label">每日活动</text>
    </view>
    <view class="mini-item" bindtap="goInvite">
      <view class="mini-icon-wrap">
        <image class="mini-icon" src="/images/icon/SVG/refer.svg" mode="aspectFit" />
      </view>
      <text class="mini-label">邀请有礼</text>
    </view>
    <view class="mini-item" bindtap="goRecharge">
      <view class="mini-icon-wrap">
        <image class="mini-icon" src="/images/icon/SVG/charge.svg" mode="aspectFit" />
      </view>
      <text class="mini-label">充值优惠</text>
    </view>
    <view class="mini-item" bindtap="goFeedback">
      <view class="mini-icon-wrap">
        <image class="mini-icon" src="/images/icon/SVG/feedback.svg" mode="aspectFit" />
      </view>
      <text class="mini-label">意见提议</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-info">
    <text class="footer-phone">电话：13773481269</text>
    <view class="footer-addrs">
      <text class="footer-addr">地址 1：扬州市广陵区泰州路43号</text>
      <text class="footer-addr">地址 2：扬州市邗江区盛福天地18楼E106号</text>
    </view>
    <text class="footer-brand">NUTS CAFE&amp;BAR</text>
  </view>

</view>

<!-- 签到弹窗 -->
<view wx:if="{{checkInShow}}" class="ci-overlay" bindtap="closeCheckIn">
  <view class="ci-card" catchtap="">
    <view class="ci-close" bindtap="closeCheckIn">×</view>
    <view class="ci-title">🎁 签到得积分！</view>
    <view class="ci-row">
      <view wx:for="{{checkInDaysTop}}" wx:key="day" class="ci-day ci-day--{{item.state}}">
        <text class="ci-star">{{item.state === 'future' ? '☆' : '★'}}</text>
        <text class="ci-pts">{{item.points}}积分</text>
        <text class="ci-lbl">第{{item.day}}天</text>
      </view>
    </view>
    <view class="ci-row ci-row--center">
      <view wx:for="{{checkInDaysBottom}}" wx:key="day" class="ci-day ci-day--{{item.state}}">
        <text class="ci-star">{{item.state === 'future' ? '☆' : '★'}}</text>
        <text class="ci-pts">{{item.points}}积分</text>
        <text class="ci-lbl">第{{item.day}}天</text>
      </view>
    </view>
    <view class="ci-btn {{checkInDone ? 'ci-btn--done' : ''}} {{checkingIn ? 'ci-btn--loading' : ''}}" bindtap="doCheckIn">
      <text class="ci-btn-text">{{checkingIn ? '签到中...' : checkInDone ? '✓ 今日已签到' : '签  到'}}</text>
    </view>
  </view>
</view>

<!-- 轮播图细则弹窗 -->
<van-popup show="{{showDetailImage}}" position="bottom" round bind:close="closeDetail" custom-style="background:#111008;max-height:88vh;overflow-y:auto;border-top:1rpx solid rgba(212,175,55,0.2);">
  <view wx:if="{{selectedBanner}}" class="bd-wrap">
    <view class="bd-drag"></view>
    <image class="bd-img" src="{{selectedBanner.detailImageUrl || selectedBanner.imageUrl}}" mode="widthFix" />
    <view class="bd-close" bindtap="closeDetail">关闭</view>
  </view>
</van-popup>

<!-- 登录 popup -->
<van-popup show="{{loginPopupShow}}" position="bottom" round bind:close="closeLoginPopup" custom-style="background:#111008;padding:48rpx 40rpx 80rpx;border-top:1rpx solid rgba(212,175,55,0.2);">
  <view class="lp-title">加入 NUTS</view>
  <view class="lp-sub">选择头像和昵称开始游戏</view>
  <button class="lp-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onPickAvatar">
    <image class="lp-avatar-img" src="{{pendingAvatar || '/images/who.png'}}" mode="aspectFill"/>
    <view class="lp-camera">📷</view>
  </button>
  <input class="lp-nick-input" type="nickname" placeholder="输入昵称（可直接使用微信昵称）" placeholder-class="lp-placeholder" value="{{pendingNick}}" bindinput="onNickInput" bindchange="onNickChange" maxlength="20" />
  <button class="lp-confirm-btn" loading="{{loginLoading}}" bindtap="confirmLogin">完成登录</button>
</van-popup>
