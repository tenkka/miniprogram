page { background: #1A1A1A; }

.page {
  padding: 24rpx 28rpx 60rpx;
}

/* ===== 余额卡片 ===== */
.balance-card {
  background: linear-gradient(135deg, #2A2618, #1E1C10);
  border: 1rpx solid rgba(212,175,55,0.3);
  border-radius: 24rpx;
  padding: 36rpx 40rpx 28rpx;
  margin-bottom: 32rpx;
}

.balance-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.balance-total-label {
  font-size: 26rpx;
  color: rgba(212,175,55,0.7);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.balance-total-val {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.balance-currency {
  font-size: 28rpx;
  font-weight: 700;
  color: #D4AF37;
}

.balance-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #D4AF37;
  line-height: 1;
  letter-spacing: -2rpx;
}

.balance-detail-row {
  display: flex;
  align-items: center;
  background: rgba(0,0,0,0.2);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.balance-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.balance-item-label {
  font-size: 22rpx;
  color: #666;
}

.balance-item-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #CCCCCC;
}

.balance-item-val.gift {
  color: #4CAF50;
}

.balance-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.08);
}

/* ===== 明细标题 ===== */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

/* ===== 加载 / 空状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 80rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  gap: 20rpx;
}

.empty-icon { font-size: 80rpx; }

.empty-text {
  font-size: 28rpx;
  color: #444;
}

/* ===== 明细条目 ===== */
.order-card {
  background: #252525;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  overflow: hidden;
}

.type-badge {
  flex-shrink: 0;
  border: 1rpx solid;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.type-text {
  font-size: 22rpx;
  font-weight: 600;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.amount-sign {
  font-size: 26rpx;
  font-weight: 700;
}

.amount-num {
  font-size: 36rpx;
  font-weight: 800;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-date {
  font-size: 24rpx;
  color: #555;
}

.price-note {
  font-size: 24rpx;
  color: #4CAF50;
}
