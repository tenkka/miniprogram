page {
  background: #0C0B09;
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0C0B09;
}

/* ===== 加载 ===== */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #555;
}

/* ===== 双列布局 ===== */
.layout {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ===== 城市列 ===== */
.city-col {
  width: 180rpx;
  flex-shrink: 0;
  background: #0F0E0B;
  border-right: 1rpx solid rgba(212,175,55,0.12);
  height: 100%;
}

.city-item {
  padding: 36rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.city-item--on {
  background: #1C1A12;
}

.city-item--on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 6rpx;
  background: #D4AF37;
  border-radius: 0 4rpx 4rpx 0;
}

.city-text {
  font-size: 28rpx;
  color: #666;
  letter-spacing: 2rpx;
}

.city-item--on .city-text {
  color: #D4AF37;
  font-weight: 600;
}

/* ===== 门店列 ===== */
.store-col {
  flex: 1;
  height: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.store-card {
  background: linear-gradient(145deg, #1C1A12 0%, #131108 100%);
  border: 1rpx solid rgba(212,175,55,0.2);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.7);
}

.store-card--active {
  border-color: rgba(212,175,55,0.55);
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.7), 0 0 0 1rpx rgba(212,175,55,0.2);
}

.store-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #F0E8CC;
  letter-spacing: 1rpx;
}

.store-select-btn {
  background: rgba(212,175,55,0.1);
  border: 1rpx solid rgba(212,175,55,0.4);
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  flex-shrink: 0;
}

.store-select-btn--active {
  background: rgba(212,175,55,0.2);
  border-color: #D4AF37;
}

.store-select-text {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: 600;
}

.store-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
}

.store-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.store-addr {
  font-size: 26rpx;
  color: #998870;
  line-height: 1.6;
  flex: 1;
}

.store-phone {
  font-size: 28rpx;
  color: #D4AF37;
  font-weight: 600;
}

/* ===== 空状态 ===== */
.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #444;
}
