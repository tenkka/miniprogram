page {
  background: #0C0B09;
  min-height: 100vh;
}

.page {
  padding: 24rpx 28rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(145deg, #1C1A12 0%, #131108 100%);
  border: 1rpx solid rgba(212,175,55,0.22);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.7), 0 1rpx 0 rgba(212,175,55,0.1) inset;
}

.tool-card-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: rgba(212,175,55,0.1);
  border: 1rpx solid rgba(212,175,55,0.25);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tool-icon {
  font-size: 44rpx;
  line-height: 1;
}

.tool-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tool-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #F0E8CC;
  letter-spacing: 1rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #7A6E58;
}

.tool-arrow {
  font-size: 44rpx;
  color: #D4AF37;
  line-height: 1;
  flex-shrink: 0;
}
