<view class="invite-page">
  <!-- 头部 -->
  <view class="hero">
    <text class="hero-spade">♠</text>
    <view class="hero-title">老带新 · 邀请有礼</view>
    <view class="hero-sub">邀好友到店体验德州扑克，赚取积分奖励</view>
  </view>

  <!-- 战绩 -->
  <view class="stat-card">
    <view class="stat-item">
      <text class="stat-num">{{totalInvited}}</text>
      <text class="stat-label">累计邀请</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{totalReward}}</text>
      <text class="stat-label">累计获得积分</text>
    </view>
  </view>

  <!-- 我的邀请码 -->
  <view class="card">
    <view class="card-title">我的邀请码</view>
    <view class="code-box">
      <text class="code-text">{{inviteCode || '——'}}</text>
      <view class="code-copy" bindtap="copyInviteCode">复制</view>
    </view>
    <button class="share-btn" open-type="share">分享给好友</button>
  </view>

  <!-- 新人填写邀请码 -->
  <view wx:if="{{canBind}}" class="card">
    <view class="card-title">填写邀请码</view>
    <view class="card-note">你是新客，填写好友邀请码后首次购买套餐，好友可得奖励</view>
    <view class="bind-row">
      <input
        class="bind-input"
        placeholder="请输入邀请码"
        placeholder-class="bind-placeholder"
        value="{{inputCode}}"
        bindinput="onInputCode"
        maxlength="8"
      />
      <view class="bind-btn {{binding ? 'bind-btn--loading' : ''}}" bindtap="bindCode">
        {{binding ? '绑定中' : '绑定'}}
      </view>
    </view>
  </view>
  <view wx:elif="{{bound}}" class="card bound-tip">
    <van-icon name="passed" size="36rpx" color="#4CAF50" />
    <text class="bound-text">已绑定邀请人</text>
  </view>
  <view wx:elif="{{isOldCustomer}}" class="card bound-tip">
    <text class="bound-text">你已是老客，可邀请新人赚积分</text>
  </view>

  <!-- 邀请记录 -->
  <view class="card">
    <view class="card-title">邀请记录</view>
    <view wx:if="{{list.length === 0}}" class="list-empty">暂无邀请记录</view>
    <view wx:else>
      <view wx:for="{{list}}" wx:key="index" class="invite-item">
        <text class="invite-nick">{{item.inviteeNick}}</text>
        <text class="invite-status {{item.status === 'rewarded' ? 'invite-status--done' : ''}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 活动须知 -->
  <view class="card">
    <view class="card-title">活动须知</view>
    <view wx:for="{{rules}}" wx:key="*this" class="rule-item">
      <view class="rule-dot"></view>
      <text class="rule-text">{{item}}</text>
    </view>
  </view>
</view>
