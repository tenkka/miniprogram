page { background: #1A1A1A; }

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 80rpx;
  box-sizing: border-box;
}

/* ===== 顶部标题 ===== */
.header {
  text-align: center;
  margin-bottom: 56rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #666;
}

/* ===== 套餐卡片 ===== */
.pkg-card {
  position: relative;
  background: #252525;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.07);
  margin-bottom: 28rpx;
  overflow: hidden;
  active-opacity: 0.7;
}

.pkg-card:active {
  opacity: 0.75;
}

.pkg-featured {
  border-color: rgba(212,175,55,0.5);
  background: #2A2618;
}

.featured-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #8B2020, #C8952A);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 0 28rpx 0 20rpx;
  letter-spacing: 2rpx;
}

.pkg-main {
  padding: 40rpx 44rpx 28rpx;
}

.pkg-recharge-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.pkg-label {
  font-size: 28rpx;
  color: #888;
  margin-right: 4rpx;
}

.pkg-currency {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pkg-amount {
  font-size: 72rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: -2rpx;
}

.pkg-divider-line {
  height: 1rpx;
  background: rgba(255,255,255,0.07);
  margin-bottom: 24rpx;
}

.pkg-gift-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pkg-gift-label {
  font-size: 26rpx;
  color: #666;
}

.pkg-gift-points-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.pkg-gift-points {
  font-size: 36rpx;
  font-weight: 700;
  color: #D4AF37;
  font-variant-numeric: tabular-nums;
}

.pkg-gift-unit {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: 600;
}

/* ===== 底部说明 ===== */
.notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.7;
  flex: 1;
}

/* ===== 确认弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-box {
  width: 100%;
  background: #252525;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 40rpx 80rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.modal-label {
  font-size: 28rpx;
  color: #888;
}

.modal-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.modal-currency {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.modal-currency.gold {
  color: #D4AF37;
}

.modal-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.modal-gift-points {
  font-size: 32rpx;
  font-weight: 700;
  color: #D4AF37;
  font-variant-numeric: tabular-nums;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-cancel {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #888;
  font-weight: 600;
}

.modal-confirm {
  flex: 2;
  height: 88rpx;
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
}

.modal-confirm--loading {
  opacity: 0.6;
}
