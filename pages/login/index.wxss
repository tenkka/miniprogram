page { background: #1A1A1A; }

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

/* 品牌区域 */
.brand-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}
.suits {
  font-size: 40rpx;
  color: #8B2020;
  letter-spacing: 16rpx;
  margin-bottom: 32rpx;
}
.logo {
  font-size: 120rpx;
  font-weight: 900;
  color: #D4AF37;
  letter-spacing: 16rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.tagline {
  font-size: 28rpx;
  color: #888888;
  letter-spacing: 6rpx;
}

/* 特性列表 */
.features {
  width: 100%;
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.feature-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  background: #2C2C2C;
  border-radius: 20rpx;
  border: 1rpx solid rgba(212,175,55,0.12);
}
.f-icon { font-size: 44rpx; }
.f-text { font-size: 28rpx; color: #CCCCCC; letter-spacing: 2rpx; }

/* 底部按钮 */
.bottom-section {
  width: 100%;
  padding-bottom: 80rpx;
}
.wechat-btn {
  width: 100%;
  height: 96rpx;
  background: #07C160;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(7,193,96,0.35);
}
.wechat-btn::after { border: none; }
.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.privacy-tip {
  font-size: 22rpx;
  color: #555555;
  text-align: center;
}
