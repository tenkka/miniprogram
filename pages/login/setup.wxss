page { background: #1A1A1A; }

.setup-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx 80rpx;
}

.setup-header {
  text-align: center;
  margin-bottom: 64rpx;
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}
.header-sub {
  font-size: 26rpx;
  color: #888888;
  letter-spacing: 2rpx;
}

/* 头像 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}
.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid #D4AF37;
}
.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #2C2C2C;
  border: 4rpx dashed #555555;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #888888;
}

/* 昵称 */
.nick-section {
  width: 100%;
  margin-bottom: 48rpx;
}
.nick-input {
  width: 100%;
  height: 96rpx;
  background: #2C2C2C;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  border: 2rpx solid rgba(212,175,55,0.2);
  box-sizing: border-box;
}
.nick-placeholder { color: #555555; }

/* 按钮 */
.confirm-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #D4AF37, #B8941F);
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(212,175,55,0.4);
  margin-bottom: 32rpx;
}
.confirm-btn::after { border: none; }
.btn-disabled {
  background: #3A3A3A !important;
  color: #666666 !important;
  box-shadow: none !important;
}
.skip-btn {
  font-size: 26rpx;
  color: #555555;
  padding: 20rpx;
}
