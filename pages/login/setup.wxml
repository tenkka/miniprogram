<view class="setup-page">

  <view class="setup-header">
    <view class="header-title">完善个人信息</view>
    <view class="header-sub">加入 NUTS，开启你的牌局之旅</view>
  </view>

  <!-- 头像选择 -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onAvatarChoose">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <van-icon name="photograph" size="64rpx" color="#666" />
      </view>
    </button>
    <view class="avatar-hint">{{ avatarUrl ? '点击更换头像' : '点击选择头像' }}</view>
  </view>

  <!-- 昵称输入 -->
  <view class="nick-section">
    <input
      class="nick-input"
      type="nickname"
      placeholder="输入昵称（可使用微信昵称）"
      placeholder-class="nick-placeholder"
      value="{{nick}}"
      bindinput="onNickInput"
      bindchange="onNickChange"
      maxlength="20"
      confirm-type="done"
    />
  </view>

  <button
    class="confirm-btn {{(!nick || !avatarUrl) ? 'btn-disabled' : ''}}"
    bindtap="confirmProfile"
    loading="{{loading}}"
  >
    进入 NUTS
  </button>

  <view class="skip-btn" bindtap="skipSetup">跳过，稍后设置</view>

</view>
