page { background: #1A1A1A; }

.plaza-container {
  min-height: 100vh;
  background: #1A1A1A;
  padding-bottom: 60rpx;
}

/* ===== 顶部 ===== */
.plaza-header {
  padding: 56rpx 40rpx 32rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.header-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

/* ===== 状态页 ===== */
.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 80rpx; }

.empty-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 600;
}

.empty-sub {
  font-size: 26rpx;
  color: #444;
}

/* ===== 帖子列表 ===== */
.post-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  background: #252525;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  position: relative;
}

.post-card.pinned {
  border-color: rgba(212,175,55,0.25);
  background: #272218;
}

/* 置顶标记 */
.pin-badge {
  font-size: 22rpx;
  color: #D4AF37;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

/* ===== 发布者 ===== */
.post-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.author-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #D4AF37;
}

.post-time {
  font-size: 22rpx;
  color: #666;
}

/* ===== 正文 ===== */
.post-content {
  font-size: 30rpx;
  color: #DDDDDD;
  line-height: 1.7;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ===== 图片 ===== */
.post-image {
  width: 100%;
  border-radius: 16rpx;
  margin-top: 24rpx;
  display: block;
}
