<view class="plaza-container">

  <!-- 顶部标题 -->
  <view class="plaza-header">
    <text class="header-title">广场</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="center-state">
    <van-loading color="#D4AF37" size="48rpx" />
  </view>

  <!-- 暂无内容 -->
  <view wx:elif="{{empty}}" class="center-state">
    <text class="empty-icon">🃏</text>
    <text class="empty-text">暂无内容</text>
    <text class="empty-sub">精彩活动即将上线，敬请期待</text>
  </view>

  <!-- 帖子列表 -->
  <view wx:else class="post-list">
    <view wx:for="{{posts}}" wx:key="_id" class="post-card {{item.pinned ? 'pinned' : ''}}">

      <!-- 置顶标记 -->
      <view wx:if="{{item.pinned}}" class="pin-badge">📌 置顶</view>

      <!-- 发布者信息 -->
      <view class="post-header">
        <image class="author-avatar-img" src="/images/logo.jpg" mode="aspectFill" />
        <view class="author-info">
          <text class="author-name">Nuts Cafe & Bar</text>
          <text class="post-time">{{item.timeLabel}}</text>
        </view>
      </view>

      <!-- 正文 -->
      <text class="post-content" user-select>{{item.content}}</text>

      <!-- 图片（可选） -->
      <image
        wx:if="{{item.imageUrl}}"
        class="post-image"
        src="{{item.imageUrl}}"
        mode="widthFix"
        data-src="{{item.imageUrl}}"
        bindtap="previewImage"
        lazy-load
      />

    </view>
  </view>

</view>
