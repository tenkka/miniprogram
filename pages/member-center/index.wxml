<view class="member-container">
  <!-- 顶部装饰波浪 -->
  <view class="top-wave"></view>
  
  <!-- 会员卡片 -->
  <view class="member-card">
    <view class="card-bg-decoration"></view>
    <view class="card-content">
      <view class="user-info">
        <view class="avatar-box">
          <image mode='aspectFill' class='avatar' src='{{apiUserInfoMap.base.avatarUrl}}'></image>
          <view class="avatar-ring"></view>
        </view>
        <view class="user-detail">
          <view class="user-name">{{apiUserInfoMap.base.nick}}</view>
          <view class="user-consumption">
            <text class="consumption-label">累计消费</text>
            <text class="consumption-value">￥{{totleConsumed}}</text>
          </view>
        </view>
      </view>
      
      <view class="member-level-box">
        <view wx:if="{{apiUserInfoMap.userLevel}}" class="level-badge">
          <text class="level-icon">👑</text>
          <text class="level-name">{{apiUserInfoMap.userLevel.name}}</text>
        </view>
        <view wx:else class="level-badge level-normal">
          <text class="level-icon">✨</text>
          <text class="level-name">非会员</text>
        </view>
        <view class="level-tip">消费达到金额可自动成为会员</view>
      </view>
    </view>
  </view>

  <!-- 会员权益说明 -->
  <view class="benefits-section">
    <view class="section-header">
      <view class="header-line"></view>
      <view class="section-title">会员成长体系</view>
      <view class="header-line"></view>
    </view>

    <!-- 表头 -->
    <view class="benefits-table-header">
      <view class="table-header-item">级别名称</view>
      <view class="table-header-item">购物折扣</view>
      <view class="table-header-item">消费标准(元)</view>
    </view>

    <!-- 等级列表卡片 -->
    <view class="level-cards">
      <view wx:for="{{levelList}}" wx:key="id" class="level-card-item">
        <view class="level-card-bg"></view>
        <view class="level-info">
          <view class="level-col">
            <view class="level-label">等级</view>
            <view class="level-value level-name-text">{{item.name}}</view>
          </view>
          <view class="level-col level-col-highlight">
            <view class="level-label">折扣</view>
            <view class="level-value discount-text">{{item.rebate}}</view>
          </view>
          <view class="level-col">
            <view class="level-label">消费额</view>
            <view class="level-value">￥{{item.upgradeAmount}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部说明 -->
  <view class="footer-remark">
    <view class="remark-icon">ℹ️</view>
    <view class="remark-text">注：当购物消费达指定标准自动成为该级别会员</view>
  </view>
</view>